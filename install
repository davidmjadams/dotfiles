#!/usr/bin/env bash
set -e

# ------------------------------------------------------------------------------
# Ensure Xcode Command Line Tools
# ------------------------------------------------------------------------------

if ! xcode-select -p >/dev/null 2>&1; then
  echo "⚠️  Xcode Command Line Tools not found."
  xcode-select --install
  echo "👉 Complete installation, then re-run ./install"
  exit 1
fi

# ------------------------------------------------------------------------------
# Bootstrap Homebrew (isolated from user git config)
# ------------------------------------------------------------------------------

if ! command -v brew >/dev/null 2>&1; then
  echo "⚠️  Homebrew not found. Installing…"

  BOOTSTRAP_HOME="$(mktemp -d)"
  export HOME="$BOOTSTRAP_HOME"

  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  # restore real HOME
  export HOME="/Users/david"
fi

# ------------------------------------------------------------------------------
# Bootstrap Python + PyYAML (Dotbot dependency)
# ------------------------------------------------------------------------------

if ! python3 - <<'EOF' >/dev/null 2>&1
import yaml
EOF
then
  echo "⚠️  Installing PyYAML"
  python3 -m pip install --user pyyaml
fi

# ------------------------------------------------------------------------------
# Bootstrap Dotbot (ignore user git config until SSH exists)
# ------------------------------------------------------------------------------

DOTBOT_DIR="dotbot"
DOTBOT_BIN="$DOTBOT_DIR/bin/dotbot"

if [ ! -x "$DOTBOT_BIN" ]; then
  echo "⚠️  Bootstrapping Dotbot"
  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_CONFIG_SYSTEM=/dev/null \
  git clone https://github.com/anishathalye/dotbot.git "$DOTBOT_DIR"
fi

# ------------------------------------------------------------------------------
# Run Dotbot (single source of truth)
# ------------------------------------------------------------------------------

echo "✓ Running Dotbot"
"$DOTBOT_BIN" -d "$PWD" -c install.conf.yaml

echo "✓ Installation complete, your mac is ready to go"
