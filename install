#!/usr/bin/env bash
set -e

# ------------------------------------------------------------------------------
# Ensure Xcode Command Line Tools are installed
# Required for git, homebrew, and compilation
# ------------------------------------------------------------------------------

if ! xcode-select -p >/dev/null 2>&1; then
  echo "⚠️  Xcode Command Line Tools not found."
  echo "Requesting installation…"
  xcode-select --install

  echo ""
  echo "👉 Please complete the Command Line Tools installation,"
  echo "👉 then re-run ./install"
  echo ""
  exit 1
fi

# ------------------------------------------------------------------------------
# Bootstrap: Homebrew
# ------------------------------------------------------------------------------

if ! command -v brew >/dev/null 2>&1; then
  echo "⚠️  Homebrew not found. Installing…"

  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_CONFIG_SYSTEM=/dev/null \
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi



# ------------------------------------------------------------------------------
# Bootstrap: Python + PyYAML (required by Dotbot)
# ------------------------------------------------------------------------------

PYTHON_BIN="$(command -v python3)"

if [ -z "$PYTHON_BIN" ]; then
  echo "❌ python3 not found."
  echo "👉 This should not happen on modern macOS."
  exit 1
fi

if ! "$PYTHON_BIN" - <<'EOF' >/dev/null 2>&1
import yaml
EOF
then
  echo "⚠️  PyYAML not found. Installing…"
  "$PYTHON_BIN" -m pip install --user --upgrade pip
  "$PYTHON_BIN" -m pip install --user pyyaml
fi

# Ensure user site-packages are on PATH (macOS-safe)
export PATH="$HOME/Library/Python/3.*/bin:$PATH"

# ------------------------------------------------------------------------------
# Bootstrap: Dotbot
# ------------------------------------------------------------------------------

DOTBOT_DIR="dotbot"
DOTBOT_BIN="$DOTBOT_DIR/bin/dotbot"
DOTBOT_REPO="https://github.com/anishathalye/dotbot.git"

if [ ! -x "$DOTBOT_BIN" ]; then
  echo "⚠️  Dotbot not found. Bootstrapping…"

  if [ ! -d "$DOTBOT_DIR" ]; then
    git clone "$DOTBOT_REPO" "$DOTBOT_DIR"
  else
    echo "⚠️  dotbot directory exists but binary missing"
    echo "👉 Please delete ./dotbot and re-run ./install"
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# Run Dotbot
# ------------------------------------------------------------------------------

echo "✓ Running Dotbot"
"$DOTBOT_BIN" -d "$PWD" -c install.conf.yaml

git submodule update --init --recursive
./dotbot/bin/dotbot -d "$PWD" -c install.conf.yaml
