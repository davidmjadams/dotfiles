[[ -r ~/.exports ]] && source ~/.exports
[[ -r ~/.aliases ]] && source ~/.aliases
[[ -r ~/.functions ]] && source ~/.functions

HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS INC_APPEND_HISTORY SHARE_HISTORY

# Zsh history search with arrow keys
autoload -Uz up-line-or-search down-line-or-search
bindkey '^[[A' up-line-or-search
bindkey '^[[B' down-line-or-search


# Git tab completion (Homebrew)
if [[ -f "$(brew --prefix)/share/zsh/site-functions/_git" ]]; then
  fpath=($(brew --prefix)/share/zsh/site-functions $fpath)
fi


autoload -Uz compinit && compinit

# ------------------------------------------------------------------------------
# Zsh autosuggestions
# Inline, history-based command suggestions (grey text ahead of cursor).
# Accept with →, word-by-word with Alt+→.
# We restrict this to history only to avoid noisy or unsafe suggestions.
# ------------------------------------------------------------------------------

if [[ -f "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

  # Subtle suggestion colour (doesn't fight syntax highlighting)
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"

  # Only suggest commands that actually exist in history
  ZSH_AUTOSUGGEST_STRATEGY=(history)
fi


setopt AUTO_MENU

command -v fnm >/dev/null && eval "$(fnm env --use-on-cd)"

export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"

export EDITOR=cursor
export VISUAL=cursor

eval "$(fnm env --use-on-cd --shell zsh)"

[[ -r ~/.extra ]] && source ~/.extra
